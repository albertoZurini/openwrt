#include "qca953x.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "datto,mp60", "qca,qca9533";
	model = "Datto MP60";

	chosen {
		/delete-property/ bootargs;
	};

	aliases {
		led-boot = &led_status_blue;
		led-failsafe = &led_status_red;
		led-running = &led_status_blue;
		led-upgrade = &led_status_green;
		label-mac-device = &eth0;
	};

	keys {
		compatible = "gpio-keys";

		pinctrl-names = "default";
		pinctrl-0 = <&jtag_disable_pins>;

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio 1 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		pinctrl-names = "default";
		pinctrl-0 = <&led_pins>;

		led_status_blue: status_blue {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&gpio 0 GPIO_ACTIVE_HIGH>;
			default-state = "on";
		};

		led_status_green: status_green {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 2 GPIO_ACTIVE_HIGH>;
		};

		led_status_red: status_red {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_RED>;
			gpios = <&gpio 3 GPIO_ACTIVE_HIGH>;
		};

		lan_green {
			function = LED_FUNCTION_LAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&gpio 13 GPIO_ACTIVE_LOW>;
		};

		lan_orange {
			function = LED_FUNCTION_LAN;
			color = <LED_COLOR_ID_ORANGE>;
			gpios = <&gpio 17 GPIO_ACTIVE_LOW>;
		};
	};

	watchdog {
		compatible = "linux,wdt-gpio";
		gpios = <&gpio 12 GPIO_ACTIVE_LOW>;
		hw_algo = "toggle";
		hw_margin_ms = <10000>;
		always-running;
	};

	i2c {
		compatible = "i2c-gpio";

		pinctrl-names = "default";
		pinctrl-0 = <&i2c_pins>;

		sda-gpios = <&gpio 14 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio 11 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;
		#address-cells = <1>;
		#size-cells = <0>;

		/* relay/metering MCU at 0x5c, driven from userspace via i2c-dev */
	};
};

&pinmux {
	led_pins: pinmux_led_pins {
		pinctrl-single,bits = <0x00 0x0 0xffff00ff>,
			<0x0c 0x0 0x0000ff00>,
			<0x10 0x0 0x0000ff00>;
	};

	i2c_pins: pinmux_i2c_pins {
		pinctrl-single,bits = <0x08 0x0 0xff000000>,
			<0x0c 0x0 0x00ff0000>,
			<0x40 0x0 0x20>;
	};
};

&spi {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		/* partitions are passed via bootloader */
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x040000>;
				read-only;
			};

			partition@40000 {
				label = "u-boot-env";
				reg = <0x040000 0x040000>;
			};

			partition@80000 {
				label = "custom";
				reg = <0x080000 0x140000>;
				read-only;
			};

			partition@1c0000 {
				label = "inactive";
				reg = <0x1c0000 0x700000>;
			};

			partition@8c0000 {
				label = "inactive2";
				reg = <0x8c0000 0x700000>;
			};

			partition@fc0000 {
				label = "ART";
				reg = <0xfc0000 0x040000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_art_0: macaddr@0 {
						compatible = "mac-base";
						reg = <0x0 0x6>;
						#nvmem-cell-cells = <1>;
					};

					cal_art_1000: calibration@1000 {
						reg = <0x1000 0x440>;
					};
				};
			};
		};
	};
};

&eth0 {
	status = "okay";

	phy-handle = <&swphy4>;

	nvmem-cells = <&macaddr_art_0 0>;
	nvmem-cell-names = "mac-address";
};

&eth1 {
	/* GMAC1 is not wired to a port, but its MDIO bus is needed for eth0 */
	compatible = "syscon", "simple-mfd";
};

&wdt {
	/* the external GPIO watchdog is used instead */
	status = "disabled";
};

&wmac {
	status = "okay";

	nvmem-cells = <&macaddr_art_0 2>, <&cal_art_1000>;
	nvmem-cell-names = "mac-address", "calibration";
};
